# Bearer API key required to access endpoints
DEEPSEEKER_API_KEY=dseeker

# Dashboard login
DEEPSEEKER_ADMIN_USER=admin
DEEPSEEKER_ADMIN_PASSWORD=admin

# Bind address (127.0.0.1 = local only, 0.0.0.0 = expose)
HOST=127.0.0.1
PORT=4000

# Public URL shown in docs/dashboard (optional; auto-detected from request if unset)
#DEEPSEEKER_PUBLIC_URL=https://api.example.com

# Token budgets for injected history when (re)building a session prompt
#DEEPSEEKER_MAX_HISTORY_TOKENS=24000
#DEEPSEEKER_MAX_TOOL_RESULT_TOKENS=12000
