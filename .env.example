# Bearer API key required to access endpoints
DEEPSEEKER_API_KEY=dseeker

# Dashboard login
DEEPSEEKER_ADMIN_USER=admin
DEEPSEEKER_ADMIN_PASSWORD=admin

# Bind address (127.0.0.1 = local only, 0.0.0.0 = expose)
HOST=127.0.0.1
PORT=4000

# Public URL shown in docs/dashboard (optional; auto-detected from request if unset)
#DEEPSEEKER_PUBLIC_URL=https://api.example.com

# Model used when a request omits "model" (instant/vision/expert)
#DEEPSEEKER_DEFAULT_MODEL=instant

# Force thinking/reasoning on for every request (useful when the client
# app has no thinking toggle)
#DEEPSEEKER_FORCE_THINKING=0

# --- Stability tunables (all optional; defaults shown) ---
# Where the WAF cookie file and SQLite DB are stored (Docker sets these to the volume)
#DEEPSEEKER_COOKIE_PATH=/app/data/aws_cookies_deepseek.json
#DB_PATH=/app/data/deeperseeker.db
# Cookie regeneration: attempts per cycle, per-cycle timeout (s), and the
# fail-fast cooldown (s) after a failed cycle so requests error quickly
# instead of queueing behind repeated browser launches
#DEEPSEEKER_COOKIE_ATTEMPTS=2
#DEEPSEEKER_COOKIE_TIMEOUT=120
#DEEPSEEKER_COOKIE_COOLDOWN=20
# Cap in-memory per-signature creation locks (memory-leak guard)
#DEEPSEEKER_MAX_SIG_LOCKS=4096
# Cap stored session signatures + prune frequency (DB-growth guard)
#DEEPSEEKER_MAX_SESSIONS=20000
#DEEPSEEKER_PRUNE_EVERY=500

# Token budgets for injected history when (re)building a session prompt
#DEEPSEEKER_MAX_HISTORY_TOKENS=24000
#DEEPSEEKER_MAX_TOOL_RESULT_TOKENS=12000
