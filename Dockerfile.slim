# Browserless variant: no Chromium, no xvfb, no playwright (~300 MB smaller image,
# much lower RAM). Requests go cookieless; if DeepSeek ever enforces its WAF on the
# API you'll get HTTP 403 errors — then switch back to the full Dockerfile.
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional

COPY . .

RUN mkdir -p /app/data

EXPOSE 4000

ENV DB_PATH=/app/data/deeperseeker.db
ENV DEEPSEEKER_COOKIE_PATH=/app/data/aws_cookies_deepseek.json

ENV HOST=0.0.0.0
ENV DEEPSEEKER_DISABLE_BROWSER=1

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -sf http://localhost:4000/health || exit 1

CMD ["node", "server.js"]
